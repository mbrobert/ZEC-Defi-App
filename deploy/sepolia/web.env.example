# Oilskin web — Base Sepolia rehearsal build (2026-09-12, slice J).
#
# Copy to web/.env.local (gitignored) and fill the four addresses from docs/DEPLOYMENTS.md. Every
# variable here is public (NEXT_PUBLIC_*): the web holds no secrets, signs nothing itself and never
# broadcasts on the user's behalf — the wallet does. A missing double or an unknown chain fails the
# build at load, by name (web/lib/chain.ts); a mainnet address can never be read on this chain.

# --- the chain ----------------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=84532
# Reads go to the chain's public endpoint by default (https://sepolia.base.org); override per deploy.
#NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org

# --- the deployment (docs/DEPLOYMENTS.md, "Base Sepolia") ----------------------------------------
NEXT_PUBLIC_OILSKIN_FACTORY=
NEXT_PUBLIC_OILSKIN_ROUTER=
# Optional: the keeper's address enables the revocable protection-grant step in the wizard. The
# observe-only rehearsal keeper has no key and therefore no address to grant to — leave it empty
# and the step says protection is not offered on this deployment.
#NEXT_PUBLIC_OILSKIN_KEEPER=

# --- the two deploy-time doubles: the keeper's CBZEC_ADDRESS / AERO_ADDRESS twins -----------------
# Same two addresses as deploy/sepolia/keeper.observe-only.env.example, same reason: Base Sepolia has
# no cbZEC and no AERO, so DeploySepolia.s.sol deploys MockB20 and MockERC20 and prints them under
# "Base Sepolia substitutes (NOT mainnet artefacts)". The onboarding page pins and links THIS cbZEC
# address (sepolia.basescan.org), so a tester sees the double, never the mainnet token. Refused on
# 8453, where both are pinned in packages/shared.
NEXT_PUBLIC_CBZEC_ADDRESS=
NEXT_PUBLIC_AERO_ADDRESS=

# --- services (mainnet-only data; the rehearsal runs without them) -------------------------------
# The yield service reads Base MAINNET gauges and Aave rates; there is no Sepolia yield. Left unset,
# the web's gate has no verdicts and offers hold-USDC / spot only — which is also today's mainnet
# verdict (docs/RISKS.md §14). CoW spot is Base mainnet only and the spot page says so on 84532.
#NEXT_PUBLIC_YIELD_URL=http://localhost:8787
#NEXT_PUBLIC_INDEXER_URL=

# --- wallets ------------------------------------------------------------------------------------
# Injected (EIP-6963) and Coinbase Wallet work without a WalletConnect project id; set one only if
# you want WalletConnect pairing on the rehearsal.
#NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Never set on a rehearsal build: NEXT_PUBLIC_FORCE_DEMO (the demo snapshot instead of the chain)
# and NEXT_PUBLIC_E2E_MOCK_WALLET (the e2e mock connector).
