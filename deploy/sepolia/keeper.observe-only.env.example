# Oilskin keeper — Base Sepolia rehearsal, OBSERVE-ONLY (2026-09-12, slice J).
#
# Copy to a file the shell can source (`set -a; . ./keeper.sepolia.env; set +a`) and fill the four
# addresses from docs/DEPLOYMENTS.md. There is deliberately NO KEEPER_PRIVATE_KEY line: without it
# the keeper values every account, walks the ladder, plans and logs every rung it WOULD dispatch,
# and signs nothing. That is the only mode this repository's sessions ever run; a signing key on
# Sepolia is the founder's decision, in his own shell, never in a checked-in file.
#
# Every other variable has a default in agent/src/config.ts (CONFIG_DEFAULTS) and is listed here
# only where the rehearsal chain changes what it means.

# --- the chain (both required; a mismatch is fatal by name, never a silent mainnet address) -----
CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL is the variable's historical name; on 84532 it must be a Base SEPOLIA endpoint. The
# keeper checks the RPC's chain id against CHAIN_ID at startup and refuses a mismatch.

# --- the deployment (docs/DEPLOYMENTS.md, "Base Sepolia") ----------------------------------------
ACCOUNT_FACTORY_ADDRESS=
STRATEGY_ROUTER_ADDRESS=
# Registry, venues and engine are READ from the router; they are not configured here.

# --- the two deploy-time doubles (required on 84532 by name; REFUSED on 8453, where both are pinned)
# packages/shared CHAINS[84532] has no cbZEC and no AERO — Base Sepolia has neither token, so
# DeploySepolia.s.sol deploys MockB20 (cbZEC's B20 shape: 8 dp, live multiplier(), blocklist,
# pause) and MockERC20 (AERO, 18 dp) and prints their addresses under
# "Base Sepolia substitutes (NOT mainnet artefacts)". Paste those two here. A missing one is
#   ConfigError: CBZEC_ADDRESS: no cbZEC address for chain 84532 in packages/shared — it is a
#   deploy-time double on this chain; set CBZEC_ADDRESS to the address DeploySepolia printed …
# The web's twins are NEXT_PUBLIC_CBZEC_ADDRESS / NEXT_PUBLIC_AERO_ADDRESS (web.env.example).
CBZEC_ADDRESS=
AERO_ADDRESS=

# --- feeds: measured, never typed ---------------------------------------------------------------
# The keeper probes each Chainlink aggregator's own recent rounds at startup and enforces
# max(ceil(largest gap × FEED_HEARTBEAT_SLACK), FEED_MIN_MAX_AGE_S) per feed. On Sepolia the BTC/USD
# and ETH/USD feeds publish about every 1,200 s (mainnet's are faster) and USDC/USD about daily;
# `node scripts/sepolia-feed-policy.mjs` prints the bounds the keeper will derive today
# (docs/SEPOLIA-REHEARSAL.md carries the 2026-09-12 read). Leave these at their defaults unless the
# startup log shows a bound you disagree with; an override is PRICE_MAX_AGE_S_<SYMBOL>=<seconds>.
#FEED_HEARTBEAT_ROUNDS=6
#FEED_HEARTBEAT_SLACK=2
#FEED_MIN_MAX_AGE_S=300
#PRICE_MAX_AGE_S=10800
#FEED_SELFCHECK=fatal

# --- store and logging ---------------------------------------------------------------------------
STORE_PATH=./keeper-store.sepolia.json
LOG_LEVEL=info
# Notifications: with no webhook the keeper refuses to start unless it is told log-only is
# acceptable — on a rehearsal it is, and the line says so.
NOTIFY_ALLOW_LOG_ONLY=1
#NOTIFY_WEBHOOK_URL=
#NOTIFY_WEBHOOK_TOKEN=

# --- discovery ----------------------------------------------------------------------------------
# Start scanning for accounts at the deployment block (docs/DEPLOYMENTS.md deployedAtBlock) so the
# first run does not walk the whole chain.
DISCOVERY_FROM_BLOCK=
#DISCOVERY_CHUNK_BLOCKS=2000
#HEALTH_POLL_MS=30000
