# ZEC Yield Orchestrator — secrets template
# Copy to .env (gitignored) and fill in. NEVER commit .env.

# ── Base chain RPC (Alchemy/Infura/etc). Paste the FULL https URL including your key.
# Example: https://base-mainnet.g.alchemy.com/v2/YOUR-KEY
BASE_RPC_URL=

# ── NEAR Intents 1-Click API JWT (skips the 0.2% integrator fee).
ONE_CLICK_JWT=

# ── Agent operator hot wallet (0x + 64 hex chars). Fund with small ETH on Base for gas.
# Use a DEDICATED key with no other funds. Leave empty for read-only mode.
OPERATOR_PRIVATE_KEY=

# ── Deployed contract addresses on Base (filled after `forge script Deploy`).
POSITION_VAULT_ADDRESS=
REWARD_ROUTER_ADDRESS=

# ── Optional: Blockscout PRO API key (live chain analytics; free at https://dev.blockscout.com)
BLOCKSCOUT_PRO_API_KEY=

# ── NEAR account used by the agent for Rhea/Burrow reads (view calls need no key).
NEAR_RPC_URL=https://rpc.mainnet.near.org

# ── Agent tuning (defaults shown; uncomment to override)
# RHEA_MODE=mock
# HEALTH_POLL_MS=60000
# MIN_COST_MULTIPLE=3
# MIN_ABSOLUTE_USD=5
