{
  "model": "claude-fable-5-1",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.foundry/keystores/**)",
      "Read(**/sensitive/**)",
      "Bash(cast wallet export:*)",
      "Bash(cat ~/.foundry/keystores/*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(forge script:*--broadcast*)",
      "Bash(cast send:*)",
      "Read(~/.config/solana/**)",
      "Read(**/target/deploy/*.json)",
      "Read(**/*-keypair.json)",
      "Bash(solana-keygen:*)",
      "Bash(cat ~/.config/solana/*)",
      "Bash(anchor deploy:*)",
      "Bash(solana program deploy:*)",
      "Bash(solana transfer:*)",
      "Bash(anchor upgrade:*)"
    ]
  }
}
